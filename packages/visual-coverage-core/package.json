{
    "name": "@preply/ds-visual-coverage-core",
    "version": "1.4.5",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "files": [
        "dist/"
    ],
    "sideEffects": false,
    "browserslist": "last 2 versions",
    "scripts": {
        "clean": "rm -rf dist",
        "test": "run check:types && run --top-level vitest --coverage --watch=false",
        "test:watch": "run --top-level vitest --watch=true",
        "check:types": "run --top-level tsc --noEmit",
        "build": "NODE_ENV=production && run build:rollup",
        "build:rollup": "run --top-level rollup -c rollup.config.cjs",
        "dev": "run build:rollup -w"
    },
    "gitHead": "43a57736ab7534349a8a7224e2ae426110af95cc"
}
