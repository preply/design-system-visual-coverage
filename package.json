{
    "name": "@preply/ds-workspace",
    "version": "0.0.0",
    "private": true,
    "workspaces": {
        "packages": [
            "packages/*",
            "support/*",
            "themes/*"
        ]
    },
    "engines": {
        "node": "20.12.2",
        "yarn": "3"
    },
    "scripts": {
        "dev": "lerna run dev --parallel",
        "test": "lerna run test --parallel --no-bail",
        "lint": "eslint --report-unused-disable-directives .",
        "clean": "lerna run clean --parallel --stream --no-bail",
        "build": "run clean && run build:packages",
        "build:packages": "lerna run build --stream"
    },
    "devDependencies": {
        "@babel/core": "7.26.9",
        "@babel/plugin-transform-runtime": "7.26.9",
        "@babel/preset-env": "7.26.9",
        "@babel/preset-react": "7.26.3",
        "@babel/preset-typescript": "7.26.0",
        "@eslint/compat": "^1.2.6",
        "@eslint/js": "^9.20.0",
        "@pixi/rollup-plugin-rename-node-modules": "^2.0.0",
        "@rollup/plugin-image": "^3.0.3",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@storybook/cli": "8.5.8",
        "@svgr/rollup": "^8.1.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "16.2.0",
        "@testing-library/react-hooks": "8.0.1",
        "@types/eslint": "^9.6.1",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/styled-components": "5.1.34",
        "@typescript-eslint/eslint-plugin": "8.24.1",
        "@typescript-eslint/parser": "8.24.1",
        "@vitest/browser": "^3.0.6",
        "@vitest/coverage-istanbul": "^3.0.6",
        "@vitest/coverage-v8": "^3.0.6",
        "autoprefixer": "^10.4.20",
        "babel-plugin-formatjs": "^10.5.35",
        "can-npm-publish": "1.3.6",
        "concurrently": "9.1.2",
        "eslint": "^9.20.1",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^3.8.2",
        "eslint-plugin-formatjs": "^5.2.14",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-mdx": "^3.1.5",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-server-components": "^1.2.0",
        "eslint-plugin-security": "^3.0.1",
        "eslint-plugin-vitest": "^0.5.4",
        "fast-glob": "^3.3.3",
        "globals": "^15.15.0",
        "http-server": "14.1.1",
        "identity-obj-proxy": "3.0.0",
        "lerna": "^8.2.0",
        "playwright": "^1.50.1",
        "postcss": "8.5.3",
        "postcss-preset-env": "^10.1.4",
        "prettier": "^3.5.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.54.2",
        "react-native": "^0.75.0",
        "rollup": "^4.34.8",
        "rollup-plugin-copy": "^3.5.0",
