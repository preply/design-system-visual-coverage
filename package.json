        "glob-parent": "5.1.2",
        "minimist": "1.2.6",
        "node-fetch": "2.6.7",
        "prismjs": "1.27.0",
        "trim": "0.0.3",
        "braces": "3.0.3",
        "@joshwooding/vite-plugin-react-docgen-typescript": "0.4.0",
        "react-docgen-typescript": "2.2.2"
    },
    "overrides": {
        "react-docgen-typescript": "2.2.2"
    },
    "packageManager": "yarn@3.8.3"
}
